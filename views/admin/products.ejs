<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('../partials/head', { title: 'Admin — Mahsulotlar' }) %>
</head>
<body>
  <%- include('../partials/header') %>

  <section>
    <div class="wrap">
      <div class="sec-head" style="display:flex; align-items:center; justify-content:space-between; max-width:none;">
        <div>
          <div class="eyebrow">Admin panel</div>
          <h2>Mahsulotlar</h2>
        </div>
        <a href="/admin/mahsulotlar/yangi" class="btn btn-primary">+ Yangi mahsulot</a>
      </div>

      <% if (products.length === 0) { %>
        <div class="empty-state">Hozircha mahsulot yo'q.</div>
      <% } else { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Nomi</th>
              <th>Kategoriya</th>
              <th>Narxi</th>
              <th>Fayl</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(p) { %>
              <tr>
                <td><%= p.name %></td>
                <td><%= p.category_name %></td>
                <td><%= p.price.toLocaleString('uz-UZ') %> so'm</td>
                <td><%= p.file_path %></td>
                <td>
                  <form method="POST" action="/admin/mahsulotlar/<%= p.id %>/ochirish" onsubmit="return confirm('Rostdan o\'chirilsinmi?');" style="display:inline;">
                    <button type="submit" class="danger-btn">O'chirish</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
