<!DOCTYPE html>
<html lang="uz">
<head>
  <%- include('partials/head', { title: "Ro'yxatdan o'tish" }) %>
</head>
<body>
  <%- include('partials/header') %>

  <div class="auth-wrap">
    <div class="card">
      <h1>Ro'yxatdan o'tish</h1>
      <p class="sub">Xarid qilish va shablonlarni yuklab olish uchun hisob yarating.</p>

      <% if (error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/royxatdan-otish">
        <div class="field">
          <label for="name">Ism</label>
          <input type="text" id="name" name="name" value="<%= name %>" required>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= email %>" required>
        </div>
        <div class="field">
          <label for="password">Parol</label>
          <input type="password" id="password" name="password" minlength="6" required>
        </div>
        <div class="field">
          <label for="password2">Parolni takrorlang</label>
          <input type="password" id="password2" name="password2" minlength="6" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-large">Ro'yxatdan o'tish</button>
      </form>

      <div class="form-foot">Hisobingiz bormi? <a href="/kirish">Kirish</a></div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
