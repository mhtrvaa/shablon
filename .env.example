# Serverni ishga tushirish porti
PORT=3000

# Sessiya (login) xavfsizligi uchun maxfiy kalit — istalgan uzun tasodifiy matn qo'ying
SESSION_SECRET=bu-yerga-uzun-tasodifiy-matn-qoying-masalan-32-belgi

# TEST_MODE=true bo'lsa, "To'lovni simulyatsiya qilish" tugmasi ko'rinadi —
# bu orqali Click/Payme haqiqiy hisobisiz butun xarid jarayonini sinab ko'rish mumkin.
# Haqiqiy to'lovlarni yoqish uchun false qiling va pastdagi kalitlarni to'ldiring.
TEST_MODE=true

# ---- CLICK ----
# https://merchant.click.uz dan olinadi
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ---- PAYME ----
# https://business.payme.uz dan olinadi
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
